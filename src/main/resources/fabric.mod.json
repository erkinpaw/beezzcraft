{
  "schemaVersion": 1,
  "id": "beezzcraft",
  "version": "${version}",
  "name": "BeezzCraft",
  "description": "Alt (rebindable in Controls) + right click on an item: an octagon wheel of everything you can craft from it. Grey means missing resources; hover for the recipe, click to craft.",
  "authors": [
    "BeezzLand"
  ],
  "contact": {
    "sources": "https://github.com/erkinpaw/beezzcraft"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "land.beezz.craft.BeezzCraft"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "~${minecraft_version}",
    "fabric-api": "*"
  },
  "mixins": [
    {
      "config": "beezzcraft.client.mixins.json",
      "environment": "client"
    }
  ]
}
